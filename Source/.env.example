# Шаблон .env. Реальные значения в .env, он в .gitignore.
# Пароль базы: grep PGPASSWORD deploy/.env.server
# Ключ Azure:  az cognitiveservices account keys list -n ezgumed-ai-swc -g ezgumed-ai-rg

# ── База: удалённый Postgres на ezgumed-app-01 через SSH-туннель ──────────────
# Локального Postgres нет, стоит только клиент libpq.
# Туннель держит LaunchAgent uz.ezgupro.ishmed.tunnel:
#   127.0.0.1:15432 -> 135.116.56.220:5432
# Проверка: make tunnel-status
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=ezgumed
PGUSER=ezgumed
PGPASSWORD=
DATABASE_URL=postgresql://ezgumed:<пароль>@127.0.0.1:15432/ezgumed

# ── Azure AI Foundry / Azure OpenAI ───────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=9d3a6846-afa3-4cb4-9b9a-fade73a7f2b8
AZURE_RESOURCE_GROUP=ezgumed-ai-rg
AZURE_AI_ACCOUNT=ezgumed-ai-swc
AZURE_AI_REGION=swedencentral

AZURE_OPENAI_ENDPOINT=https://ezgumed-ai-swc.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Прикладная роль БД ────────────────────────────────────────────────────────
# Бот и веб ходят под ishmed_app, а НЕ под владельцем ezgumed.
# Ставится скриптом: ./db/set-app-role-password.sh (после миграции 011)
APP_DATABASE_URL=postgresql://ishmed_app:<пароль>@127.0.0.1:15432/ezgumed

# ── Telegram (бот для медиков) ────────────────────────────────────────────────
# Токен от @BotFather. Если утёк — /revoke и заменить здесь.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ishmedbot

# ── Модели: разделены по задержке, замеряно на живых вызовах ───────────────────
# диалог 1.7 c (mini + minimal), извлечение 2.3 c (gpt-5 + minimal)
AZURE_OPENAI_DIALOG_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_STT_DEPLOYMENT=gpt-4o-transcribe

# ── Веб-платформа клиник ──────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_SECRET_KEY=
WEB_BASE_URL=https://ishmed.ezgupro.uz

# ── Демо-аккаунт клиники (пароль в БД только хэшем argon2) ────────────────────
DEMO_CLINIC_EMAIL=clinica@ishmed.uz
DEMO_CLINIC_PASSWORD=
DEMO_CLINIC_NAME="Demo Clinic Tashkent"

# ── Прочее ────────────────────────────────────────────────────────────────────
CONSENT_VERSION=2026-08-16
DEMO_MODE=false
